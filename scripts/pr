#!/bin/sh
# pr — open a review in Prchum from the terminal.
#
#   pr change.diff              a patch or exchange file
#   pr 418                      PR 418 of the current repo's origin
#   pr owner/repo#418           explicit repository
#   pr https://github.com/...   a request URL
#   pr                          the home screen
#
# Talks to the running app through the prchum:// URL scheme, launching
# it when needed.

set -eu

target="${1:-}"

# Paths must survive the app's different working directory.
if [ -n "$target" ] && [ -e "$target" ]; then
    case "$target" in
        /*) ;;
        *) target="$(pwd)/$target" ;;
    esac
fi

encoded=$(printf '%s' "$target" | od -An -tx1 | tr -d ' \n' | sed 's/../%&/g')
exec open "prchum://open?target=$encoded"
